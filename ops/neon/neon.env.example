# Copy to ops/neon/neon.env (git-ignored) for ops/neon/*.sh. No passwords here: they are typed or passed in the
# environment for one command. ADR-017: the database is the Neon Free project star_index (PostgreSQL 18, Singapore).
#
# DIRECT endpoint (the host WITHOUT "-pooler"): Flyway, pg_dump and pg_restore need a session, not a pooled one.
DB_URL=jdbc:postgresql://ep-REPLACE-ME.ap-southeast-1.aws.neon.tech/starindex?sslmode=require&channelBinding=require
# Neon's built-in admin login (CREATEROLE CREATEDB, not a superuser) and its database.
NEON_ADMIN_USER=neondb_owner
NEON_ADMIN_DB=neondb
