# Copy to backend/.env (never committed) and fill in. Spring loads it automatically (spring.config.import).
#
# data.go.kr → 마이페이지 → 개발계정 → 일반 인증키 (Decoding). One key covers every approved API:
#   기상청 단기예보 조회서비스 15084084 · 한국천문연구원 출몰시각 15012688 · 천문현상 15012691
#   (선택) 특일 15012690 · 음양력 15012679
# Use the Decoding key (raw, may contain + / =). The client URL-encodes it exactly once.
DATA_GO_KR_SERVICE_KEY=

# Optional overrides (defaults match backend/docker-compose.yml)
# DB_URL=jdbc:postgresql://127.0.0.1:15432/starindex
# DB_USERNAME=starindex
# DB_PASSWORD=starindex-local
# REDIS_HOST=127.0.0.1
# REDIS_PORT=16379
# PACK_LOCAL_DIR=build/packs
# ETL_SCHEDULE_ENABLED=false
