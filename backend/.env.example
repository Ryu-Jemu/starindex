# Copy to backend/.env (never committed) and fill in. Spring loads it automatically (spring.config.import).
#
# data.go.kr → 마이페이지 → 개발계정 → 일반 인증키 (Decoding). One key covers every approved API:
#   기상청 단기예보 조회서비스 15084084 · 한국천문연구원 출몰시각 15012688 · 천문현상 15012691
#   (선택) 특일 15012690 · 음양력 15012679
# Use the Decoding key (raw, may contain + / =). The client URL-encodes it exactly once.
DATA_GO_KR_SERVICE_KEY=

# Optional overrides (defaults match backend/docker-compose.yml)
# DB_URL=jdbc:postgresql://127.0.0.1:15432/starindex
# DB_USERNAME=starindex
# DB_PASSWORD=starindex-local
# REDIS_HOST=127.0.0.1
# REDIS_PORT=16379
# PACK_LOCAL_DIR=build/packs
# ETL_SCHEDULE_ENABLED=false

# Local admin page (http://localhost:8080/admin, loopback only). bcrypt hash of the admin password:
#   htpasswd -nbBC 12 "" '<password>' | tr -d ':\n'
# ADMIN_PASSWORD_HASH=
# ADMIN_JWT_SECRET=          # base64 ≥ 32 bytes; empty → random per start (fine locally)

# Local development only. Production (Neon) settings live in ops/neon/app.env and are used by scripts/admin-neon.sh,
# so scripts/etl.sh and bootRun never write to the production database. Pack bucket keys (S3 API of Neon Object
# Storage) for local experiments:
# PACK_BUCKET=starindex-packs
# AWS_ENDPOINT_URL_S3=https://br-….storage.c-N.aws-ap-southeast-1….neon.tech
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=           # Neon storage credential token_id (not an AWS key)
# AWS_SECRET_ACCESS_KEY=       # Neon storage credential s3_secret_access_key
