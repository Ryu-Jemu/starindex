# /etc/starindex/app.env (EnvironmentFile of starindex.service). No secrets here: deploy/app/start.sh reads the DB
# password, the data.go.kr key, the CloudFront origin secret and the admin login from SSM SecureString at start.
#
# Database: Neon Free, PostgreSQL 18, region aws-ap-southeast-1 (ADR-015; no RDS, not even for the demo). Use the
# DIRECT endpoint (the hostname WITHOUT "-pooler"): Flyway, pg_dump and pg_restore need it.
DB_URL=jdbc:postgresql://ep-REPLACE-ME.ap-southeast-1.aws.neon.tech/starindex?sslmode=require&channelBinding=require
DB_USERNAME=starindex
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
PACK_LOCAL_DIR=/var/lib/starindex/packs
# Bucket for packs/ (the app, behind CloudFront) and backup/db/ (deploy/postgres/backup.sh). Empty → packs stay in
# PACK_LOCAL_DIR and install.sh skips the backup timer. On a CloudFormation stack the CodeDeploy AfterInstall hook
# copies S3_BUCKET, DB_URL, CLOUDFRONT_* and AWS_REGION from /etc/starindex/stack.env into this file on every deploy.
S3_BUCKET=
CLOUDFRONT_DISTRIBUTION_ID=
CLOUDFRONT_DOMAIN=
AWS_REGION=ap-northeast-2
ETL_SCHEDULE_ENABLED=true
# StarIndex/PackAgeMinutes to CloudWatch every 5 minutes (alarm: > 360 or missing).
METRICS_ENABLED=true

# JVM for t4g.small (DB-PLAN 4.4): heap 512m + metaspace/code cache/direct caps ≈ 820–900 MiB RSS at most.
# For t4g.micro (DB-PLAN 11.6) use -Xmx384m and Valkey maxmemory 64mb.
# SerialGC: 2 vCPU, small heap, batch and admin traffic — pauses do not matter, G1's extra memory does.
# scripts/ec2sim.sh uses this same line (with the GC log moved to /tmp).
JAVA_OPTS=-Xmx512m -Xss512k -XX:+UseSerialGC -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=64m -XX:MaxDirectMemorySize=64m -XX:+ExitOnOutOfMemoryError -Xlog:gc:file=/var/log/starindex/gc.log:time,uptime:filecount=3,filesize=5m
MALLOC_ARENA_MAX=2
