# /etc/starindex/app.env (EnvironmentFile of starindex.service). No secrets here: deploy/app/start.sh reads the DB
# password and the data.go.kr key from SSM SecureString at start (DB-PLAN 5.4).
#
# Switching between EC2 PostgreSQL and RDS changes only DB_URL (DB-PLAN 5.7), e.g.
#   DB_URL=jdbc:postgresql://<rds-endpoint>:5432/starindex?sslmode=require
DB_URL=jdbc:postgresql://127.0.0.1:5432/starindex
DB_USERNAME=starindex
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
PACK_LOCAL_DIR=/var/lib/starindex/packs
# Bucket for backup/db/ (deploy/postgres/backup.sh) and, from W3, packs/. Empty → install.sh skips the backup timer.
S3_BUCKET=
ETL_SCHEDULE_ENABLED=true

# JVM for t4g.small (DB-PLAN 4.4 and 5.3): heap 512m + metaspace/code cache/direct caps ≈ 820–900 MiB RSS.
# SerialGC: 2 vCPU, small heap, batch and admin traffic — pauses do not matter, G1's extra memory does.
# scripts/ec2sim.sh uses this same line (with the GC log moved to /tmp).
JAVA_OPTS=-Xmx512m -Xss512k -XX:+UseSerialGC -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=64m -XX:MaxDirectMemorySize=64m -XX:+ExitOnOutOfMemoryError -Xlog:gc:file=/var/log/starindex/gc.log:time,uptime:filecount=3,filesize=5m
MALLOC_ARENA_MAX=2
