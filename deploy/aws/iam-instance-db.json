{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DbBackups",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::starindex-ACCOUNT_ID/backup/db/*"
    },
    {
      "Sid": "Packs",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::starindex-ACCOUNT_ID/packs/*"
    },
    {
      "Sid": "PackRetentionDeletesVersionsOnly",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": [
        "arn:aws:s3:::starindex-ACCOUNT_ID/packs/index/*",
        "arn:aws:s3:::starindex-ACCOUNT_ID/packs/events/*",
        "arn:aws:s3:::starindex-ACCOUNT_ID/packs/spots/*"
      ]
    },
    {
      "Sid": "ListBackupsAndPacks",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::starindex-ACCOUNT_ID",
      "Condition": { "StringLike": { "s3:prefix": ["backup/db/*", "packs/*"] } }
    },
    {
      "Sid": "Secrets",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID:parameter/starindex/*"
    },
    {
      "Sid": "DecryptSecureStringViaSsm",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": { "StringEquals": { "kms:ViaService": "ssm.ap-northeast-2.amazonaws.com" } }
    }
  ]
}
