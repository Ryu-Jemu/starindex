# 20:20 UTC = 05:20 KST, five minutes after the 05:15 forecast run: the Neon compute is still awake, so the dump costs
# no extra wake-up (ADR-015). Written in UTC so no time zone suffix is needed.
[Unit]
Description=Daily StarIndex pg_dump

[Timer]
OnCalendar=*-*-* 20:20:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
