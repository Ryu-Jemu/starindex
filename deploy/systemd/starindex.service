# StarIndex backend (ADR-015: the database is Neon, reached over TLS; Valkey runs locally).
[Unit]
Description=StarIndex backend (ETL scheduler, public API, admin)
Wants=network-online.target valkey.service
After=network-online.target valkey.service
# A startup crash loop must not keep Neon awake (every start connects and resets its 5-minute suspend timer):
# at most 5 starts per hour, then the unit stays failed (fix, then: systemctl reset-failed starindex && systemctl start starindex).
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
User=starindex
Group=starindex
WorkingDirectory=/opt/starindex
EnvironmentFile=/etc/starindex/app.env
ExecStart=/opt/starindex/start.sh
Restart=on-failure
RestartSec=120
# 143 = SIGTERM exit of the JVM after a graceful shutdown
SuccessExitStatus=143
TimeoutStopSec=60
StateDirectory=starindex
LogsDirectory=starindex
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
