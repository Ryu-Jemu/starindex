# StarIndex backend (DB-PLAN 5.8). Wants (not Requires) postgresql: while DB_URL points at RDS the local server may not
# exist; Hikari reconnects when PostgreSQL restarts.
[Unit]
Description=StarIndex backend (ETL scheduler, public API, admin)
Wants=network-online.target postgresql.service valkey.service
After=network-online.target postgresql.service valkey.service

[Service]
User=starindex
Group=starindex
WorkingDirectory=/opt/starindex
EnvironmentFile=/etc/starindex/app.env
ExecStart=/opt/starindex/start.sh
Restart=on-failure
RestartSec=10
# 143 = SIGTERM exit of the JVM after a graceful shutdown
SuccessExitStatus=143
TimeoutStopSec=60
StateDirectory=starindex
LogsDirectory=starindex
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
